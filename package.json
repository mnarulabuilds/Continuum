{
  "name": "continuum-cdn",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "node --watch --import=tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import=tsx --test-isolation=process --test tests/**/*.test.ts",
    "test:watch": "node --import=tsx --watch --test-isolation=process --test tests/**/*.test.ts"
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "cookie": "^1.1.1",
    "google-auth-library": "^10.5.0",
    "ioredis": "^5.9.2",
    "node-forge": "^1.3.3",
    "nodemailer": "^10.0.6",
    "prom-client": "^15.1.0",
    "sharp": "^0.35.4",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
