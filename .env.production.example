# Copy to .env.production and fill in real values before deploying:
#   cp .env.production.example .env.production

NODE_ENV=production
PORT=5000
CLUSTER_ENABLED=true
MAX_WORKERS=4

# Required — generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-32-byte-secret
ADMIN_EMAIL_ALLOWLIST=you@example.com
COOKIE_SECURE=true
TRUST_PROXY=true

# Redis (required when CLUSTER_ENABLED=true)
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Choose at least one login method (production will refuse to start without one)

# Option A — Email OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM=you@example.com

# Option B — Google OAuth (set GOOGLE_* and leave SMTP blank if preferred)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# TLS — terminate at Caddy/Nginx/Traefik in front of the app for most VPS setups
HTTPS_ENABLED=false
HTTPS_REDIRECT=false

# Optional
ADMIN_WHITELIST_IPS=
ACME_EMAIL=you@example.com
ACME_DIRECTORY=production
PROMETHEUS_ENABLED=false
LOG_LEVEL=info
LOG_FORMAT=json
ANALYTICS_ENABLED=true
WEBSOCKET_ENABLED=false
CACHE_MAX_SIZE_MB=10240
RATE_LIMIT_MAX=100
DEFAULT_TTL=3600
