# Node/runtime
NODE_ENV=development
PORT=4000
CLUSTER_ENABLED=false

# Required for production. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-32-byte-secret
ADMIN_EMAIL_ALLOWLIST=admin@example.com
COOKIE_SECURE=false

# Persistence (required for clustered production deployments)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Upstream safety
ORIGIN_TIMEOUT_MS=10000
MAX_REQUEST_BODY_BYTES=1048576
MAX_ORIGIN_RESPONSE_BYTES=52428800

# HTTPS (terminate TLS at a reverse proxy unless SNI certificates are configured)
HTTPS_ENABLED=false
HTTPS_REDIRECT=false

# Administrator login (configure at least one method; in development, OTP codes are logged to the console when SMTP is unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@continuum-cdn.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
