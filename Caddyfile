# Replace your-domain.com with your real domain before enabling the proxy profile.
# DNS A/AAAA records must point to this server first so Let's Encrypt can issue certs.

your-domain.com {
	encode gzip zstd
	reverse_proxy continuum:5000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
